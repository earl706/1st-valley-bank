# First Valley Bank - Environment Variables Template
# Copy this file to .env.local for local development

# ===========================================
# API Configuration
# ===========================================
# Backend API base URL
VITE_API_BASE_URL=http://127.0.0.1:8000/api

# ===========================================
# Mapbox Configuration
# ===========================================
# Mapbox access token for maps and geocoding
VITE_MAPBOX_ACCESS_TOKEN=your_mapbox_access_token_here

# ===========================================
# Application Configuration
# ===========================================
# Application environment (development, staging, production)
VITE_APP_ENV=development

# Application name
VITE_APP_NAME=First Valley Bank

# Application version
VITE_APP_VERSION=1.0.0

# ===========================================
# Feature Flags
# ===========================================
# Enable/disable chatbot feature
VITE_ENABLE_CHATBOT=true

# Enable/disable newsletter subscription
VITE_ENABLE_NEWSLETTER=true

# Enable/disable property listings
VITE_ENABLE_PROPERTIES=true

# ===========================================
# External Services (Optional)
# ===========================================
# Google Analytics tracking ID (optional)
VITE_GA_TRACKING_ID=

# Sentry DSN for error tracking (optional)
VITE_SENTRY_DSN=

# ===========================================
# Development Settings
# ===========================================
# Enable debug mode
VITE_DEBUG=false

# Enable API request logging
VITE_LOG_API_REQUESTS=false
